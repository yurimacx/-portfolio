NODE_ENV=development
PORT=3000
# URL pública do site (usada na checagem de Origin). Em produção: https://seudominio.com
SITE_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://portfolio:troque_esta_senha@localhost:5432/portfolio
# true em bancos gerenciados (AWS RDS, etc.)
DB_SSL=false
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Usados só pelo comando npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Aviso por e-mail quando alguém enviar mensagem (opcional; sem SMTP_HOST, só grava no banco)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
